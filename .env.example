# Public values only. Never put service_role keys, payment secrets or private API keys here.
# All three of API_URL, SUPABASE_URL and SUPABASE_ANON_KEY are required. There is no demo mode.
# EAS cloud builds do not read this file: set the same values as EAS environment variables.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Licensed OSM-compatible raster tile provider or a policy-compliant owned proxy.
EXPO_PUBLIC_TILE_URL=
EXPO_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Your OSRM-compatible routing server/proxy base URL (not the public demo server).
EXPO_PUBLIC_ROUTING_URL=
# Your compliant Nominatim-compatible backend proxy URL.
EXPO_PUBLIC_GEOCODING_URL=
